// Cloudflare Workers config: serves this repo's static files with no server code.
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "name": "portfolio",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./",
    "not_found_handling": "404-page"
  },
  // Required by `wrangler preview`, which Workers Builds runs for pull requests.
  // Docs: https://developers.cloudflare.com/workers/previews/configuration/
  "previews": {}
}
